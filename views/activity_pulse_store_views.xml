<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_activity_pulse_store_item_list" model="ir.ui.view">
        <field name="name">activity.pulse.store.item.list</field>
        <field name="model">activity.pulse.store.item</field>
        <field name="arch" type="xml">
            <list string="آیتم‌های فروشگاه">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="price"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_activity_pulse_store_item_form" model="ir.ui.view">
        <field name="name">activity.pulse.store.item.form</field>
        <field name="model">activity.pulse.store.item</field>
        <field name="arch" type="xml">
            <form string="آیتم فروشگاه">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <group>
                        <field name="name" placeholder="مثلاً: یک روز مرخصی"/>
                        <field name="price"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="توضیحات">
                        <field name="description" nolabel="1" placeholder="توضیح کوتاهی درباره این آیتم..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_activity_pulse_store_item" model="ir.actions.act_window">
        <field name="name">آیتم‌های فروشگاه</field>
        <field name="res_model">activity.pulse.store.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nodata_smiling_face">هنوز آیتمی توی فروشگاه نساختید</p>
            <p>مثلاً «یک روز مرخصی» با قیمت ۱۰۰۰ سکه.</p>
        </field>
    </record>

    <menuitem id="menu_activity_pulse_store_item"
              name="مدیریت فروشگاه"
              parent="menu_activity_pulse_root"
              action="action_activity_pulse_store_item"
              groups="activity_pulse.group_activity_pulse_manager"
              sequence="30"/>

</odoo>
